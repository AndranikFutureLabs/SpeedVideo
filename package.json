{
  "name": "skorost-video",
  "version": "1.0.0",
  "description": "Приложение для настройки и сохранения скорости воспроизведения видео",
  "author": "AndranikFutureLabs",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node build-electron.mjs && vite",
    "build": "vue-tsc --noEmit && vite build && node build-electron.mjs",
    "preview": "vite preview",
    "electron:dev": "node build-electron.mjs && vite build && electron .",
    "electron:build": "vue-tsc --noEmit && vite build && node build-electron.mjs && electron-builder --win --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.25.12": true
  }
}
